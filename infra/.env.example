# ─────────────────────────────────────────────────────────────
# Langfuse Auth
# Generate with:
#   openssl rand -hex 32   → LANGFUSE_NEXTAUTH_SECRET
#   openssl rand -hex 16   → LANGFUSE_SALT
# ─────────────────────────────────────────────────────────────
LANGFUSE_NEXTAUTH_SECRET=replace-with-openssl-rand-hex-32
LANGFUSE_SALT=replace-with-openssl-rand-hex-16

# ─────────────────────────────────────────────────────────────
# Langfuse API Keys
# These must match LANGFUSE_INIT_PROJECT_PUBLIC/SECRET_KEY in docker-compose.yml
# ─────────────────────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=pk-lf-local-orchestrator
LANGFUSE_SECRET_KEY=sk-lf-local-orchestrator
LANGFUSE_URL=http://localhost:3001

# ─────────────────────────────────────────────────────────────
# Qdrant (Vector DB for RAG)
# ─────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333

# ─────────────────────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6380

# ─────────────────────────────────────────────────────────────
# NATS (inter-agent messaging)
# ─────────────────────────────────────────────────────────────
NATS_URL=nats://localhost:4222

# ─────────────────────────────────────────────────────────────
# Ollama (local embeddings — no API key needed)
# ─────────────────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
